{
    "openapi": "3.0.3",
    "info": {
        "title": "settings-administration",
        "version": "0.0.1",
        "description": "Nextcloud settings",
        "license": {
            "name": "agpl"
        }
    },
    "components": {
        "securitySchemes": {
            "basic_auth": {
                "type": "http",
                "scheme": "basic"
            },
            "bearer_auth": {
                "type": "http",
                "scheme": "bearer"
            }
        },
        "schemas": {
            "OCSMeta": {
                "type": "object",
                "required": [
                    "status",
                    "statuscode"
                ],
                "properties": {
                    "status": {
                        "type": "string"
                    },
                    "statuscode": {
                        "type": "integer"
                    },
                    "message": {
                        "type": "string"
                    },
                    "totalitems": {
                        "type": "string"
                    },
                    "itemsperpage": {
                        "type": "string"
                    }
                }
            },
            "PreviewProvider": {
                "type": "object",
                "required": [
                    "class",
                    "name",
                    "mimetypes",
                    "requirement",
                    "available",
                    "enabled"
                ],
                "properties": {
                    "class": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "mimetypes": {
                        "type": "string"
                    },
                    "requirement": {
                        "type": "string",
                        "enum": [
                            "none",
                            "imagick",
                            "office",
                            "ffmpeg",
                            "imaginary"
                        ]
                    },
                    "available": {
                        "type": "boolean"
                    },
                    "enabled": {
                        "type": "boolean"
                    }
                }
            },
            "PreviewSettings": {
                "type": "object",
                "required": [
                    "configIsReadOnly",
                    "enabled",
                    "maxX",
                    "maxY",
                    "maxMemory",
                    "maxFilesizeImage",
                    "jpegQuality",
                    "webpQuality",
                    "concurrencyNew",
                    "concurrencyAll",
                    "expirationDays",
                    "providersConfigured",
                    "providers",
                    "dependencies"
                ],
                "properties": {
                    "configIsReadOnly": {
                        "type": "boolean"
                    },
                    "enabled": {
                        "type": "boolean"
                    },
                    "maxX": {
                        "type": "integer",
                        "format": "int64",
                        "nullable": true
                    },
                    "maxY": {
                        "type": "integer",
                        "format": "int64",
                        "nullable": true
                    },
                    "maxMemory": {
                        "type": "integer",
                        "format": "int64",
                        "nullable": true
                    },
                    "maxFilesizeImage": {
                        "type": "integer",
                        "format": "int64",
                        "nullable": true
                    },
                    "jpegQuality": {
                        "type": "integer",
                        "format": "int64",
                        "nullable": true
                    },
                    "webpQuality": {
                        "type": "integer",
                        "format": "int64",
                        "nullable": true
                    },
                    "concurrencyNew": {
                        "type": "integer",
                        "format": "int64",
                        "nullable": true
                    },
                    "concurrencyAll": {
                        "type": "integer",
                        "format": "int64",
                        "nullable": true
                    },
                    "expirationDays": {
                        "type": "integer",
                        "format": "int64",
                        "nullable": true
                    },
                    "providersConfigured": {
                        "type": "boolean"
                    },
                    "providers": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/PreviewProvider"
                        }
                    },
                    "dependencies": {
                        "type": "object",
                        "required": [
                            "imagick",
                            "ffmpeg",
                            "office",
                            "imaginary"
                        ],
                        "properties": {
                            "imagick": {
                                "type": "boolean"
                            },
                            "ffmpeg": {
                                "type": "string",
                                "nullable": true
                            },
                            "office": {
                                "type": "string",
                                "nullable": true
                            },
                            "imaginary": {
                                "type": "boolean"
                            }
                        }
                    }
                }
            }
        }
    },
    "paths": {
        "/index.php/settings/admin/log/download": {
            "get": {
                "operationId": "log_settings-download",
                "summary": "download logfile",
                "description": "This endpoint requires admin access",
                "tags": [
                    "log_settings"
                ],
                "security": [
                    {
                        "bearer_auth": []
                    },
                    {
                        "basic_auth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Logfile returned",
                        "headers": {
                            "Content-Disposition": {
                                "schema": {
                                    "type": "string",
                                    "enum": [
                                        "attachment; filename=\"nextcloud.log\""
                                    ]
                                }
                            }
                        },
                        "content": {
                            "application/octet-stream": {
                                "schema": {
                                    "type": "string",
                                    "format": "binary"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Current user is not logged in",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "message"
                                    ],
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Logged in account must be an admin",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "message"
                                    ],
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/ocs/v2.php/apps/settings/api/admin/previews/settings": {
            "put": {
                "operationId": "preview_settings-update-settings",
                "summary": "Update the preview settings",
                "description": "A `null` value, or the default value, removes the setting so the default applies.\nThis endpoint requires admin access\nThis endpoint requires password confirmation",
                "tags": [
                    "preview_settings"
                ],
                "security": [
                    {
                        "bearer_auth": []
                    },
                    {
                        "basic_auth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "enabled"
                                ],
                                "properties": {
                                    "enabled": {
                                        "type": "boolean",
                                        "description": "Whether previews are generated and served"
                                    },
                                    "maxX": {
                                        "type": "integer",
                                        "format": "int64",
                                        "nullable": true,
                                        "description": "Maximum preview width in pixels"
                                    },
                                    "maxY": {
                                        "type": "integer",
                                        "format": "int64",
                                        "nullable": true,
                                        "description": "Maximum preview height in pixels"
                                    },
                                    "maxMemory": {
                                        "type": "integer",
                                        "format": "int64",
                                        "nullable": true,
                                        "description": "Maximum memory in MB for a preview generated in PHP, -1 for no limit"
                                    },
                                    "maxFilesizeImage": {
                                        "type": "integer",
                                        "format": "int64",
                                        "nullable": true,
                                        "description": "Maximum size in MB of a source image, -1 for no limit"
                                    },
                                    "jpegQuality": {
                                        "type": "integer",
                                        "format": "int64",
                                        "nullable": true,
                                        "description": "JPEG quality, 1 to 100"
                                    },
                                    "webpQuality": {
                                        "type": "integer",
                                        "format": "int64",
                                        "nullable": true,
                                        "description": "WebP quality, 1 to 100"
                                    },
                                    "concurrencyNew": {
                                        "type": "integer",
                                        "format": "int64",
                                        "nullable": true,
                                        "description": "Number of previews generated at the same time"
                                    },
                                    "concurrencyAll": {
                                        "type": "integer",
                                        "format": "int64",
                                        "nullable": true,
                                        "description": "Number of preview requests handled at the same time"
                                    },
                                    "expirationDays": {
                                        "type": "integer",
                                        "format": "int64",
                                        "nullable": true,
                                        "description": "Days after which generated previews are deleted, 0 to keep them"
                                    }
                                }
                            }
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "OCS-APIRequest",
                        "in": "header",
                        "description": "Required to be true for the API request to pass",
                        "required": true,
                        "schema": {
                            "type": "boolean",
                            "default": true
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Settings updated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "ocs"
                                    ],
                                    "properties": {
                                        "ocs": {
                                            "type": "object",
                                            "required": [
                                                "meta",
                                                "data"
                                            ],
                                            "properties": {
                                                "meta": {
                                                    "$ref": "#/components/schemas/OCSMeta"
                                                },
                                                "data": {
                                                    "$ref": "#/components/schemas/PreviewSettings"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "A value is out of range",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "ocs"
                                    ],
                                    "properties": {
                                        "ocs": {
                                            "type": "object",
                                            "required": [
                                                "meta",
                                                "data"
                                            ],
                                            "properties": {
                                                "meta": {
                                                    "$ref": "#/components/schemas/OCSMeta"
                                                },
                                                "data": {}
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "The configuration is read-only",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "anyOf": [
                                        {
                                            "type": "object",
                                            "required": [
                                                "ocs"
                                            ],
                                            "properties": {
                                                "ocs": {
                                                    "type": "object",
                                                    "required": [
                                                        "meta",
                                                        "data"
                                                    ],
                                                    "properties": {
                                                        "meta": {
                                                            "$ref": "#/components/schemas/OCSMeta"
                                                        },
                                                        "data": {}
                                                    }
                                                }
                                            }
                                        },
                                        {
                                            "type": "object",
                                            "required": [
                                                "ocs"
                                            ],
                                            "properties": {
                                                "ocs": {
                                                    "type": "object",
                                                    "required": [
                                                        "meta",
                                                        "data"
                                                    ],
                                                    "properties": {
                                                        "meta": {
                                                            "$ref": "#/components/schemas/OCSMeta"
                                                        },
                                                        "data": {}
                                                    }
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Current user is not logged in",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "ocs"
                                    ],
                                    "properties": {
                                        "ocs": {
                                            "type": "object",
                                            "required": [
                                                "meta",
                                                "data"
                                            ],
                                            "properties": {
                                                "meta": {
                                                    "$ref": "#/components/schemas/OCSMeta"
                                                },
                                                "data": {}
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/ocs/v2.php/apps/settings/api/admin/previews/providers": {
            "put": {
                "operationId": "preview_settings-update-providers",
                "summary": "Set the enabled preview providers",
                "description": "This endpoint requires admin access\nThis endpoint requires password confirmation",
                "tags": [
                    "preview_settings"
                ],
                "security": [
                    {
                        "bearer_auth": []
                    },
                    {
                        "basic_auth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "providers"
                                ],
                                "properties": {
                                    "providers": {
                                        "type": "array",
                                        "description": "Provider classes in the order they are tried",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "OCS-APIRequest",
                        "in": "header",
                        "description": "Required to be true for the API request to pass",
                        "required": true,
                        "schema": {
                            "type": "boolean",
                            "default": true
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Providers updated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "ocs"
                                    ],
                                    "properties": {
                                        "ocs": {
                                            "type": "object",
                                            "required": [
                                                "meta",
                                                "data"
                                            ],
                                            "properties": {
                                                "meta": {
                                                    "$ref": "#/components/schemas/OCSMeta"
                                                },
                                                "data": {
                                                    "$ref": "#/components/schemas/PreviewSettings"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "A provider is unknown",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "ocs"
                                    ],
                                    "properties": {
                                        "ocs": {
                                            "type": "object",
                                            "required": [
                                                "meta",
                                                "data"
                                            ],
                                            "properties": {
                                                "meta": {
                                                    "$ref": "#/components/schemas/OCSMeta"
                                                },
                                                "data": {}
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "The configuration is read-only",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "anyOf": [
                                        {
                                            "type": "object",
                                            "required": [
                                                "ocs"
                                            ],
                                            "properties": {
                                                "ocs": {
                                                    "type": "object",
                                                    "required": [
                                                        "meta",
                                                        "data"
                                                    ],
                                                    "properties": {
                                                        "meta": {
                                                            "$ref": "#/components/schemas/OCSMeta"
                                                        },
                                                        "data": {}
                                                    }
                                                }
                                            }
                                        },
                                        {
                                            "type": "object",
                                            "required": [
                                                "ocs"
                                            ],
                                            "properties": {
                                                "ocs": {
                                                    "type": "object",
                                                    "required": [
                                                        "meta",
                                                        "data"
                                                    ],
                                                    "properties": {
                                                        "meta": {
                                                            "$ref": "#/components/schemas/OCSMeta"
                                                        },
                                                        "data": {}
                                                    }
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Current user is not logged in",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "ocs"
                                    ],
                                    "properties": {
                                        "ocs": {
                                            "type": "object",
                                            "required": [
                                                "meta",
                                                "data"
                                            ],
                                            "properties": {
                                                "meta": {
                                                    "$ref": "#/components/schemas/OCSMeta"
                                                },
                                                "data": {}
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "operationId": "preview_settings-reset-providers",
                "summary": "Reset the preview providers to the default list",
                "description": "This endpoint requires admin access\nThis endpoint requires password confirmation",
                "tags": [
                    "preview_settings"
                ],
                "security": [
                    {
                        "bearer_auth": []
                    },
                    {
                        "basic_auth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "OCS-APIRequest",
                        "in": "header",
                        "description": "Required to be true for the API request to pass",
                        "required": true,
                        "schema": {
                            "type": "boolean",
                            "default": true
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Providers reset",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "ocs"
                                    ],
                                    "properties": {
                                        "ocs": {
                                            "type": "object",
                                            "required": [
                                                "meta",
                                                "data"
                                            ],
                                            "properties": {
                                                "meta": {
                                                    "$ref": "#/components/schemas/OCSMeta"
                                                },
                                                "data": {
                                                    "$ref": "#/components/schemas/PreviewSettings"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "The configuration is read-only",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "anyOf": [
                                        {
                                            "type": "object",
                                            "required": [
                                                "ocs"
                                            ],
                                            "properties": {
                                                "ocs": {
                                                    "type": "object",
                                                    "required": [
                                                        "meta",
                                                        "data"
                                                    ],
                                                    "properties": {
                                                        "meta": {
                                                            "$ref": "#/components/schemas/OCSMeta"
                                                        },
                                                        "data": {}
                                                    }
                                                }
                                            }
                                        },
                                        {
                                            "type": "object",
                                            "required": [
                                                "ocs"
                                            ],
                                            "properties": {
                                                "ocs": {
                                                    "type": "object",
                                                    "required": [
                                                        "meta",
                                                        "data"
                                                    ],
                                                    "properties": {
                                                        "meta": {
                                                            "$ref": "#/components/schemas/OCSMeta"
                                                        },
                                                        "data": {}
                                                    }
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Current user is not logged in",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "ocs"
                                    ],
                                    "properties": {
                                        "ocs": {
                                            "type": "object",
                                            "required": [
                                                "meta",
                                                "data"
                                            ],
                                            "properties": {
                                                "meta": {
                                                    "$ref": "#/components/schemas/OCSMeta"
                                                },
                                                "data": {}
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "tags": []
}
