{
  "name": "nextcloud",
  "version": "1.0.0",
  "private": true,
  "description": "Nextcloud Server",
  "keywords": [
    "nextcloud"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nextcloud/server.git"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Nextcloud GmbH and Nextcloud contributors",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "postbuild": "build/npm-post-build.sh",
    "dev": "NODE_ENV=development vite build --mode development",
    "lint": "eslint --suppressions-location build/eslint-baseline.json --no-error-on-unmatched-pattern",
    "lint:fix": "npm run lint -- --fix",
    "playwright": "playwright test --project=default --project=admin-settings",
    "playwright:install": "playwright install chromium",
    "playwright:integration": "playwright test --project=integration",
    "playwright:setup": "playwright test --project=setup",
    "sass": "sass --style compressed --load-path core/css core/css/ $(for cssdir in $(find apps -mindepth 2 -maxdepth 2 -name \"css\"); do if ! $(git check-ignore -q $cssdir); then printf \"$cssdir \"; fi; done)",
    "sass:icons": "node build/icons.mjs",
    "sass:watch": "sass --watch --load-path core/css core/css/ $(for cssdir in $(find apps -mindepth 2 -maxdepth 2 -name \"css\"); do if ! $(git check-ignore -q $cssdir); then printf \"$cssdir \"; fi; done)",
    "stylelint": "stylelint $(for appdir in $(ls apps); do if ! $(git check-ignore -q \"apps/$appdir\"); then printf \"'apps/$appdir/**/*.{scss,vue}' \"; fi; done) 'core/**/*.{scss,vue}'",
    "stylelint:fix": "npm run stylelint -- --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --reporter=default",
    "test:update-snapshots": "vitest run --update",
    "test:watch": "vitest watch",
    "watch": "NODE_ENV=development vite build --mode development --watch"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "overrides": {
    "@nextcloud/files": "$@nextcloud/files"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@mdi/svg": "^7.4.47",
    "@nextcloud/auth": "^2.6.0",
    "@nextcloud/axios": "^2.5.2",
    "@nextcloud/browser-storage": "^0.5.0",
    "@nextcloud/calendar-availability-vue": "^3.0.0",
    "@nextcloud/capabilities": "^1.2.1",
    "@nextcloud/dialogs": "^8.0.0",
    "@nextcloud/event-bus": "^3.3.3",
    "@nextcloud/files": "^4.1.1",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/logger": "^3.0.3",
    "@nextcloud/password-confirmation": "^6.2.1",
    "@nextcloud/paths": "^3.1.0",
    "@nextcloud/router": "^3.2.0",
    "@nextcloud/sharing": "^1.0.0-beta.4",
    "@nextcloud/viewer": "^2.0.0-beta.21",
    "@nextcloud/vue": "^9.14.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "browserslist-useragent-regexp": "^4.1.4",
    "color": "^5.0.3",
    "core-js": "^3.51.0",
    "cropperjs": "^2.3.1",
    "debounce": "^3.0.0",
    "dompurify": "^3.4.18",
    "escape-html": "^1.0.3",
    "focus-trap": "^8.2.5",
    "libphonenumber-js": "^1.13.16",
    "marked": "^18.2.1",
    "moment": "^2.31.0",
    "p-queue": "^10.0.0",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "webdav": "^5.11.0"
  },
  "devDependencies": {
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/e2e-test-server": "^0.6.1",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/stylelint-config": "^3.2.2",
    "@nextcloud/typings": "^1.10.0",
    "@nextcloud/vite-config": "^2.5.2",
    "@pinia/testing": "^2.0.2",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/vue": "^8.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "@zip.js/zip.js": "^2.25.0",
    "axe-core": "^4.14.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "is-svg": "^6.1.0",
    "jsdom": "^31.0.1",
    "jsdom-testing-mocks": "^1.16.0",
    "mime": "^4.1.2",
    "msw": "^3.0.6",
    "sass": "^1.108.2",
    "stylelint": "^17.15.0",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.3.0"
  }
}
